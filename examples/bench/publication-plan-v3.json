{
  "id": "kairn-scientific-evidence-v3",
  "name": "Kairn Scientific Evidence Campaign v3",
  "description": "Frozen pre-announcement evidence bundle excluding private beta telemetry. It separates fresh preflight, pass/pass live canaries, MCP endurance proof, no-governor ablation, and official SWE-Pro evaluator readiness.",
  "reportDate": "2026-05-18",
  "defaults": {
    "model": "gpt-5.4-mini",
    "repeat": 3,
    "agentTimeoutMs": 240000,
    "turnTimeoutMs": 240000,
    "workdir": "/tmp/kairn-publication-v3-workdirs",
    "modes": ["baseline", "kairn_codex_session"],
    "commands": {
      "baseline": "codex -a never exec --model {model} --sandbox danger-full-access --disable hooks {prompt}",
      "kairn_codex_session": "kairn codex --root {root} --model {model} --sandbox danger-full-access {prompt}",
      "kairn_codex_session_no_governor": "codex -a never exec --model {model} --sandbox danger-full-access --disable hooks {prompt}",
      "real_mcp_first": "codex -a never exec --model {model} --sandbox danger-full-access --disable hooks {prompt}",
      "hybrid_mcp_brief": "codex -a never exec --model {model} --sandbox danger-full-access --enable hooks {prompt}"
    },
    "setupCommands": {
      "kairn_codex_session": "kairn setup codex --root {root} --mode savings >/dev/null",
      "real_mcp_first": "kairn setup codex --root {root} --mode mcp-first --session {session} >/dev/null",
      "hybrid_mcp_brief": "kairn setup codex --root {root} --mode hybrid --session {session} >/dev/null"
    }
  },
  "entries": [
    {
      "id": "fresh-publication-v3-preflight",
      "kind": "matrix",
      "label": "Frozen fresh repo preflight",
      "repoId": "fresh-publication-v3",
      "language": "mixed",
      "sizeClass": "mixed",
      "taskClass": "fresh_preflight",
      "matrix": "examples/bench/repo-matrix-publication-v3.json"
    },
    {
      "id": "fresh-live-repeat3-canary",
      "kind": "proof",
      "label": "Repeat-3 live seeded canary for pass/pass token savings",
      "repoId": "seeded-fresh-holdout-v2",
      "language": "mixed",
      "sizeClass": "mixed",
      "taskClass": "source_rescue",
      "root": ".",
      "suite": "examples/bench/seeded-fresh-holdout-v2-20260511.json",
      "repeat": 3,
      "shuffleOrder": true,
      "modes": ["baseline", "kairn_codex_session"]
    },
    {
      "id": "ablation-proof-repeat3",
      "kind": "proof",
      "label": "Governor ablation on seeded one-shot tasks",
      "repoId": "seeded-ablation-canary",
      "language": "mixed",
      "sizeClass": "mixed",
      "taskClass": "ablation",
      "root": ".",
      "suite": "examples/bench/seeded-fresh-holdout-20260510.json",
      "repeat": 3,
      "shuffleOrder": true,
      "modes": ["baseline", "kairn_codex_session", "kairn_codex_session_no_governor"]
    },
    {
      "id": "requests-endurance-ablation-repeat3",
      "kind": "endurance",
      "label": "Requests 10-turn governor ablation",
      "repoId": "requests",
      "language": "python",
      "sizeClass": "medium",
      "taskClass": "session_repeat",
      "contextBehavior": "session_repeat",
      "root": ".",
      "suite": "examples/bench/endurance-requests-10turn.json",
      "repeat": 3,
      "modes": ["baseline", "kairn_codex_session", "kairn_codex_session_no_governor"]
    },
    {
      "id": "httpcore-mcp-endurance-repeat3",
      "kind": "endurance",
      "label": "Fresh httpcore MCP endurance repeat-3",
      "repoId": "httpcore",
      "language": "python",
      "sizeClass": "medium",
      "taskClass": "session_repeat",
      "contextBehavior": "source_rescue",
      "root": ".",
      "suite": "examples/bench/endurance-httpcore.json",
      "repeat": 3,
      "modes": ["baseline", "real_mcp_first"]
    },
    {
      "id": "requests-mcp-endurance-repeat3",
      "kind": "endurance",
      "label": "Requests MCP endurance repeat-3 regression proof",
      "repoId": "requests",
      "language": "python",
      "sizeClass": "medium",
      "taskClass": "session_repeat",
      "contextBehavior": "source_rescue",
      "root": ".",
      "suite": "examples/bench/endurance-requests-10turn.json",
      "repeat": 3,
      "modes": ["baseline", "real_mcp_first", "hybrid_mcp_brief"]
    },
    {
      "id": "local-mcp-smoke-v3",
      "kind": "mcp_smoke",
      "label": "Local MCP protocol smoke",
      "repoId": "local",
      "language": "mixed",
      "sizeClass": "unknown",
      "taskClass": "mcp_delivery",
      "root": ".",
      "task": "Find the smallest useful Kairn source context for evidence-campaign reporting.",
      "budget": 700,
      "detail": "compact"
    },
    {
      "id": "swe-pro-official-eval-v3",
      "kind": "swe_pro_official_eval",
      "label": "SWE-Pro official evaluator slice",
      "repoId": "swe-bench-pro",
      "language": "mixed",
      "sizeClass": "mixed",
      "taskClass": "official_patch",
      "input": "examples/bench/swe-pro-publication/swe-pro-pilot-raw.jsonl",
