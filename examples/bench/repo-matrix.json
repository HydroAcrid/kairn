{
  "id": "broad-repo-matrix",
  "name": "Broad Repo Retrieval Preflight",
  "gates": {
    "maxStateMb": 250,
    "maxPrimeLatencyMs": 6000,
    "expectedTopK": 5,
    "requireSuppressionForWeakCases": true
  },
  "repos": [
    {
      "id": "tanstack-query",
      "name": "TanStack Query",
      "repoUrl": "https://github.com/TanStack/query.git",
      "ref": "3894b052b75f1b8a35235e804aadc815db67878d",
      "cloneDepth": 1,
      "language": "typescript",
      "sizeClass": "large",
      "cases": [
        {
          "id": "hidden-hash-debug",
          "mode": "context",
          "task": "Debug object query key hashing: keys with the same properties in different orders should hash consistently.",
          "expectedFiles": [
            "packages/query-core/src/utils.ts"
          ],
          "excludedFiles": [
            "docs/",
            "examples/",
            "packages/query-codemods/",
            "packages/query-devtools/"
          ],
          "budget": 900
        }
      ]
    },
    {
      "id": "click",
      "name": "Click",
