{
  "id": "repo-matrix-private-beta-v3",
  "name": "Kairn Private Beta Fresh Holdout V3",
  "gates": {
    "maxStateMb": 250,
    "maxPrimeLatencyMs": 10000,
    "expectedTopK": 5,
    "requireSuppressionForWeakCases": true
  },
  "repos": [
    {
      "id": "vite",
      "name": "Vite",
      "repoUrl": "https://github.com/vitejs/vite.git",
      "cloneDepth": 1,
      "language": "typescript",
      "sizeClass": "large",
      "cases": [
        {
          "id": "plugin-container-resolve",
          "mode": "context",
          "contextBehavior": "multi_file_debug",
          "task": "Debug Vite plugin container module resolution when resolveId and load hooks coordinate across dev server transforms.",
          "expectedFiles": [
            "packages/vite/src/node/server/pluginContainer.ts",
            "packages/vite/src/node/plugins/importAnalysis.ts"
          ],
          "excludedFiles": ["docs/", "playground/", "packages/vite/src/node/__tests__/"],
          "budget": 900
        }
      ]
    },
    {
      "id": "zod",
      "name": "Zod",
      "repoUrl": "https://github.com/colinhacks/zod.git",
      "cloneDepth": 1,
      "language": "typescript",
      "sizeClass": "medium",
      "cases": [
        {
          "id": "object-parse-shape",
          "mode": "context",
          "contextBehavior": "source_rescue",
          "task": "Debug Zod object parsing when unknown keys and shape validation interact in the core object schema implementation.",
          "expectedFiles": ["packages/zod/src/v4/core/schemas.ts"],
          "excludedFiles": ["packages/*/src/*/*.test.ts", "docs/", "rfcs/"],
          "budget": 800
        }
      ]
    },
    {
      "id": "rich",
      "name": "Rich",
      "repoUrl": "https://github.com/Textualize/rich.git",
      "cloneDepth": 1,
      "language": "python",
      "sizeClass": "medium",
      "cases": [
        {
          "id": "console-render-measure",
          "mode": "context",
          "contextBehavior": "multi_file_debug",
          "task": "Debug Rich console rendering and measurement behavior when styled segments wrap and width is calculated.",
          "expectedFiles": ["rich/console.py", "rich/measure.py", "rich/segment.py"],
          "excludedFiles": ["docs/", "examples/", "tests/"],
          "budget": 900
        }
      ]
    },
    {
      "id": "httpcore",
      "name": "httpcore",
      "repoUrl": "https://github.com/encode/httpcore.git",
      "cloneDepth": 1,
      "language": "python",
      "sizeClass": "medium",
      "cases": [
        {
          "id": "connection-pool-retry",
          "mode": "context",
          "contextBehavior": "failure_first",
          "task": "Debug httpcore connection pool retry and request dispatch behavior after a connection failure.",
          "expectedFiles": ["httpcore/_sync/connection_pool.py", "httpcore/_sync/connection.py"],
          "excludedFiles": ["docs/", "tests/"],
          "budget": 850
        }
      ]
    },
    {
      "id": "chi",
      "name": "Chi",
      "repoUrl": "https://github.com/go-chi/chi.git",
      "cloneDepth": 1,
      "language": "go",
      "sizeClass": "medium",
      "cases": [
        {
          "id": "mux-route-context",
          "mode": "context",
          "contextBehavior": "multi_file_debug",
          "task": "Debug chi router route context behavior when middleware and route patterns dispatch through the mux.",
          "expectedFiles": ["mux.go", "context.go", "tree.go"],
          "excludedFiles": ["_examples/", "middleware/*_test.go"],
          "budget": 850
        }
      ]
    },
    {
      "id": "zap",
      "name": "Zap",
      "repoUrl": "https://github.com/uber-go/zap.git",
      "cloneDepth": 1,
      "language": "go",
      "sizeClass": "medium",
      "cases": [
        {
          "id": "core-entry-write",
          "mode": "context",
          "contextBehavior": "source_rescue",
          "task": "Debug zap core entry writing when checked entries dispatch fields to the underlying core and encoder.",
          "expectedFiles": ["zapcore/core.go", "zapcore/entry.go", "zapcore/encoder.go"],
          "excludedFiles": ["internal/*test*", "zaptest/", "benchmarks/"],
          "budget": 850
        }
      ]
    },
    {
      "id": "okhttp",
      "name": "OkHttp",
      "repoUrl": "https://github.com/square/okhttp.git",
      "cloneDepth": 1,
      "language": "java",
      "sizeClass": "large",
      "cases": [
        {
          "id": "interceptor-chain-call",
          "mode": "context",
          "contextBehavior": "multi_file_debug",
          "task": "Debug OkHttp interceptor chain behavior when real calls proceed through application and network interceptors.",
          "expectedFiles": ["okhttp/src/commonJvmAndroid/kotlin/okhttp3/internal/http/RealInterceptorChain.kt", "okhttp/src/commonJvmAndroid/kotlin/okhttp3/internal/connection/RealCall.kt"],
          "excludedFiles": ["**/src/test/", "docs/", "samples/"],
          "budget": 900
        }
      ]
    },
    {
      "id": "spdlog",
      "name": "spdlog",
      "repoUrl": "https://github.com/gabime/spdlog.git",
      "cloneDepth": 1,
      "language": "cpp",
      "sizeClass": "medium",
      "cases": [
        {
          "id": "logger-sink-dispatch",
          "mode": "context",
          "contextBehavior": "source_rescue",
          "task": "Debug spdlog logger sink dispatch behavior when a log message fans out through sinks and flush policy.",
          "expectedFiles": ["include/spdlog/logger.h", "include/spdlog/sinks/sink.h"],
          "excludedFiles": ["tests/", "example/", "bench/"],
          "budget": 850
        }
      ]
    },
    {
      "id": "weak-signal-canary",
      "name": "Zod Weak Signal Canary",
      "repoUrl": "https://github.com/colinhacks/zod.git",
      "cloneDepth": 1,
      "language": "typescript",
      "sizeClass": "medium",
      "cases": [
        {
          "id": "vague-cleanup",
          "mode": "context",
          "contextBehavior": "weak_signal",
          "task": "Make this better and clean up the confusing part.",
          "expectedFiles": [],
          "excludedFiles": ["docs/", "packages/*/src/*/*.test.ts"],
          "successCriteria": ["suppress low-confidence context"],
          "budget": 500
        }
      ]
    }
  ]
}
