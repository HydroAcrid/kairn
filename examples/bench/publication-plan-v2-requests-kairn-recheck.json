      "language": "python",
      "sizeClass": "medium",
      "taskClass": "session_repeat",
      "contextBehavior": "source_rescue",
      "root": ".",
      "suite": "examples/bench/endurance-requests-10turn.json",
      "repeat": 2,
      "modes": ["baseline", "kairn_codex_session"]
    }
  ]
