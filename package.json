{
  "name": "kairn",
  "version": "0.1.4",
  "private": true,
  "description": "Local-first dynamic context runtime for software engineering agents.",
  "type": "module",
  "bin": {
    "kairn": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/preinstall-check.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node20 --dts --clean --external typescript --external web-tree-sitter --external @repomix/tree-sitter-wasms",
    "dev": "tsx src/cli.ts",
    "kairn": "node dist/cli.js",
    "preinstall": "node ./scripts/preinstall-check.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release:validate-npm": "node scripts/release/validate-npm-packages.mjs",
    "release:stage-platform": "node scripts/release/stage-platform-package.mjs",
    "release:build-pkg-binary": "node scripts/release/build-pkg-binary.mjs",
    "release:build-binary": "node scripts/release/build-platform-binary.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "context",
    "developer-tools"
  ],
  "author": "Kevin Dotel",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19 <26"
  },
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@repomix/tree-sitter-wasms": "0.1.17",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "picocolors": "^1.1.1",
    "simple-git": "^3.36.0",
    "typescript": "^6.0.3",
    "web-tree-sitter": "0.26.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "esbuild": "0.27.7",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
