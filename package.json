{
  "name": "usekairn",
  "version": "0.2.0-beta.1",
  "description": "Local repository evidence and token-efficiency layer for coding agents.",
  "type": "module",
  "bin": {
    "kairn": "./dist/cli.js"
  },
  "files": [
    "dist",
    "benchmarks",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node20 --dts --clean --external typescript --external web-tree-sitter --external @repomix/tree-sitter-wasms",
    "dev": "tsx src/cli.ts",
    "kairn": "node dist/cli.js",
    "preinstall": "node ./scripts/preinstall-check.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:licenses": "node scripts/generate-license-report.mjs",
    "check:licenses:all": "node scripts/generate-license-report.mjs --all",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:history": "node scripts/check-secrets.mjs --history",
    "check:dco": "node scripts/check-dco.mjs",
    "check:headers": "node scripts/check-license-headers.mjs",
    "check:semantic-architecture": "node scripts/check-semantic-architecture.mjs",
    "fix:headers": "node scripts/check-license-headers.mjs --fix",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "smoke:offline": "node scripts/offline-runtime-smoke.mjs",
    "smoke:enable-disable": "node scripts/enable-disable-smoke.mjs",
    "smoke:package": "node scripts/smoke-packed-package.mjs",
    "verify:ranker-sample": "node scripts/verify-sample-model.mjs",
    "verify:ranker-promotion-sample": "python3 scripts/evaluate-ranker-promotion.py --input benchmarks/evidence-promotion.sample.json --allow-sample",
    "verify:codex-pilot-smoke": "vitest run tests/codexPilot.test.ts",
    "ranker:intake:public": "tsx scripts/build-public-evidence-intake.ts",
    "ranker:intake:detached-holdout": "tsx scripts/build-detached-holdout-intake.ts",
    "ranker:synthetic-variants": "tsx scripts/build-synthetic-prompt-variants.ts",
    "ranker:materialize": "tsx scripts/materialize-evidence-corpus.ts",
    "ranker:review-queue": "tsx scripts/build-corpus-review-queue.ts",
    "ranker:carry-reviews": "tsx scripts/carry-forward-corpus-reviews.ts",
    "ranker:review-batches": "tsx scripts/corpus-review-batches.ts",
    "ranker:apply-reviews": "tsx scripts/apply-corpus-review-decisions.ts",
    "ranker:checkpoint": "tsx scripts/build-ranker-diagnostic-checkpoint.ts",
    "ranker:readiness": "tsx scripts/build-ranker-readiness-checkpoint.ts",
    "ranker:probe-diagnostic": "tsx scripts/build-probe-ranker-diagnostic.ts",
    "ranker:evaluate-probe": "tsx scripts/evaluate-probe-ranker-diagnostic.ts",
    "semantic:evaluate-model": "tsx scripts/evaluate-semantic-model.ts",
    "semantic:inspect-query": "tsx scripts/inspect-semantic-query.ts",
    "semantic:benchmark-runtime": "tsx scripts/benchmark-semantic-runtime.ts",
    "ranker:corpus": "python3 scripts/build-evidence-corpus.py",
    "ranker:train": "python3 scripts/train-evidence-ranker.py --out artifacts/kairn-evidence-v02c-20260722.json --model-id kairn-evidence-v02c-20260722 --node node --public-data-only",
    "ranker:promote": "python3 scripts/evaluate-ranker-promotion.py --out artifacts/ranker-promotion-report.json",
    "ranker:reproduce": "node scripts/reproduce-evidence-ranker.mjs",
    "codex:pilot:install": "node scripts/install-codex-pilot.mjs",
    "verify:experiment-smoke": "tsx scripts/verify-comparison-smoke.ts",
    "benchmark:doctor": "tsx scripts/benchmark-doctor.ts",
    "benchmark:cache": "tsx scripts/benchmark-cache.ts",
    "benchmark:compare": "tsx scripts/benchmark-compare.ts",
    "benchmark:tier-a": "tsx scripts/verify-benchmark-tier-a.ts",
    "benchmark:tier-b": "tsx scripts/verify-benchmark-tier-b.ts",
    "benchmark:reproduce": "tsx scripts/benchmark-reproduce.ts",
    "benchmark:rankability-audit": "tsx scripts/benchmark-rankability-audit.ts",
    "verify:release-checksums": "node scripts/verify-release-checksums.mjs",
    "verify:package-contents": "node scripts/verify-package-contents.mjs",
    "verify:supply-chain-reports": "node scripts/verify-supply-chain-reports.mjs",
    "release:checksums": "node scripts/generate-release-checksums.mjs",
    "train:ranker:sample": "python3 scripts/train-evidence-ranker.py --input benchmarks/evidence-training.sample.jsonl --out artifacts/sample-evidence-model.json --model-id sample-evidence-v1 --node node --public-data-only",
    "sbom": "node scripts/generate-sbom.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "context",
    "developer-tools",
    "local-first",
    "repository",
    "token-efficiency"
  ],
  "author": "Kevin Dotel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HydroAcrid/kairn.git"
  },
  "homepage": "https://www.usekairn.com",
  "bugs": {
    "url": "https://github.com/HydroAcrid/kairn/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19 <26"
  },
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@inquirer/prompts": "^8.4.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@repomix/tree-sitter-wasms": "0.1.17",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "onnxruntime-web": "1.27.0",
    "picocolors": "^1.1.1",
    "simple-git": "^3.36.0",
    "typescript": "^6.0.3",
    "web-tree-sitter": "0.26.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "esbuild": "0.27.7",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
