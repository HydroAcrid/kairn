{
  "name": "kairn",
  "version": "0.1.0",
  "description": "Local-first dynamic context runtime for software engineering agents.",
  "type": "module",
  "bin": {
    "kairn": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/preinstall-check.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node20 --dts --clean --external typescript",
    "dev": "tsx src/cli.ts",
    "kairn": "node dist/cli.js",
    "preinstall": "node ./scripts/preinstall-check.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "context",
    "developer-tools"
  ],
  "author": "Kevin Dotel",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <24"
  },
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "tree-sitter",
      "tree-sitter-c",
      "tree-sitter-cpp",
      "tree-sitter-java",
      "tree-sitter-javascript",
      "tree-sitter-python",
      "tree-sitter-typescript"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "simple-git": "^3.36.0",
    "tree-sitter": "0.25.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
