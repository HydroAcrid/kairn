{
  "id": "governance-routing-followup-iteration2-20260610",
  "name": "Governance routing follow-up iteration 2",
  "description": "Proxy-first recheck after narrowing request body/form source expansion to one handler plus one reconstruction utility.",
  "defaults": {
    "model": "gpt-5.4-mini",
    "parallel": 1,
    "agentTimeoutMs": 900000,
    "turnTimeoutMs": 480000,
    "cleanup": "never",
    "commands": {
      "baseline": "codex -a never exec --model {model} --sandbox danger-full-access --disable hooks {prompt}",
      "kairn_codex_session": "node \"$KAIRN_CLI_PATH\" codex --root {root} --model {model} --sandbox danger-full-access --skip-git-repo-check {prompt}",
      "real_mcp_first": "codex -a never exec --model {model} --sandbox danger-full-access --disable hooks {prompt}",
      "hybrid_mcp_brief": "codex -a never exec --model {model} --sandbox danger-full-access --enable hooks {prompt}"
    },
    "setupCommands": {
      "real_mcp_first": "node \"$KAIRN_CLI_PATH\" setup codex --root {root} --mode mcp-first >/dev/null",
      "hybrid_mcp_brief": "node \"$KAIRN_CLI_PATH\" setup codex --root {root} --mode hybrid --session {session} >/dev/null"
    }
  },
  "pauseRules": {
    "maxQualityDrops": 0,
    "maxScopeViolations": 0,
    "maxRepeatedFailureClass": 1,
    "maxTokenRegressionClass": 1,
    "stopOnHarnessFailure": true
  },
