+import org.apache.commons.codec.binary.StringUtils;
+
+public final class Probe {
+    private static final class Sequence implements CharSequence {
+        private final String value;
+        private Sequence(String value) { this.value = value; }
+        public int length() { return value.length(); }
+        public char charAt(int index) { return value.charAt(index); }
+        public CharSequence subSequence(int start, int end) { return value.subSequence(start, end); }
+        public String toString() { return value; }
+    }
+
+    public static void main(String[] args) {
+        if (StringUtils.equals(new Sequence("Token"), new Sequence("token"))) {
+            throw new AssertionError("comparison became case-insensitive");
+        }
+        if (!StringUtils.equals(new Sequence("Token"), new Sequence("Token"))) {
+            throw new AssertionError("equal custom sequences did not match");
+        }
+    }
+}
